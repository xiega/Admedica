# Skopiuj do .env.local (lokalnie) albo wpisz w ustawieniach hostingu. NIGDY nie commituj prawdziwych wartości.

# Klucz szyfrujący (32 losowe bajty w base64). Wygeneruj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Zmiana klucza unieważnia wszystkie dotychczas wysłane linki.
RECEPTA_KEY=

# Wspólne hasło do panelu recepcji (/recepcja). Ustaw długie i unikalne.
RECEPCJA_PASSWORD=

# Pełny adres strony, bez ukośnika na końcu – trafia do linku w mailu.
SITE_URL=https://twoja-domena.pl

# Poczta (Resend, https://resend.com). MAIL_FROM musi być z zweryfikowanej domeny.
RESEND_API_KEY=
MAIL_FROM=Admedica <recepty@twoja-domena.pl>

# Baza zgłoszeń (opcjonalnie, ale zalecana): adres skryptu php-api/recepty.php na serwerze z MySQL
# i ten sam token co 'api_token' w config.php na serwerze. Instrukcja: php-api/README.md.
# Gdy puste, strona działa w trybie "tylko mail z zaszyfrowanym linkiem".
RECEPTY_API_URL=https://twoja-domena.pl/api-recepty/recepty.php
RECEPTY_API_TOKEN=

# Adres recepcji (z bazą: tylko powiadomienie bez danych; można zostawić puste). Opcjonalnie osobne adresy dla placówek (jeśli puste, używany jest MAIL_TO).
MAIL_TO=recepcja@twoja-domena.pl
MAIL_TO_BOHATEROW=
MAIL_TO_SZCZEPANKOWO=
